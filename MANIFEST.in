# The sdist is the install path for any platform we don't publish a wheel for, so it
# has to contain everything setup.py needs at build time.
include LICENSE
include README.md
include requirements.txt
include pyproject.toml
# the native layer and the draken headers it is built on (setup.py refuses to build without them)
recursive-include native *.h *.hpp *.c *.cpp *.txt SOURCE
